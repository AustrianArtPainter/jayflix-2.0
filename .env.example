# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=

# 管理员功能的独立密码；与访问密码一样，仅服务端读取。
ADMINPASSWORD=

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认社区实例 https://60s.crystelf.top。
# 失败时回退公共实例 https://60s.viki.moe；上游可用性与限流不能由本地构建保证。
# 60S_API_BASE=https://60s.crystelf.top

# 可选：调试
DEBUG=false

# Node/Docker 自建 IPTV 可显式开启；Workers 的 public-only fetch 无法访问内网。
# LIVE_ALLOW_PRIVATE=1

# 预置源与订阅（JSON）；运行时设置，所有用户输入仍需 SSRF 校验。
# DEFAULT_SOURCES=[]
# DEFAULT_LIVE_SOURCES=[]
# DEFAULT_SUBSCRIPTIONS=[]
# DEFAULT_RECOMMEND_SOURCE=douban
# DEFAULT_IMAGE_MODE=direct

# EPG bounded metadata (bytes). Workers hard caps equal these defaults.
# Node/Docker upper caps: input 16MiB, expanded 64MiB, parsed estimate 32MiB, 100000 programmes.
# EPG_MAX_INPUT_BYTES=4194304
# EPG_MAX_EXPANDED_BYTES=8388608
# EPG_MAX_PARSED_BYTES=8388608
# EPG_MAX_PROGRAMS=20000
# Live metadata cache default/hard Workers cap: 16MiB; Node may explicitly raise to 256MiB.
# LIVE_CACHE_MAX_BYTES=16777216

# M3U playlist metadata bounds. Workers hard caps match these defaults.
# Node/Docker upper caps: input 16MiB, parsed estimate 32MiB, 100000 channels.
# M3U_MAX_INPUT_BYTES=4194304
# M3U_MAX_PARSED_BYTES=8388608
# M3U_MAX_CHANNELS=20000

# 本地 Wrangler 预览可在 .dev.vars 中设置 NEXTJS_ENV=development。
# Node 本地开发可用 .env.local；Worker 预览仅用一次性 .dev.vars/--var fixture。
# OpenNext 会编译 .env* 服务端 fallback；Worker 构建时勿放入真实密码文件，生产值仅用运行时 secret binding。
