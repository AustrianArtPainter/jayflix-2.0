{
  "name": "jayflix-2.0",
  "version": "2.0.0",
  "private": true,
  "description": "Jayflix 2.0 · 自适应球体影视搜索、点播与直播平台",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "next start -p 8080",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:build": "opennextjs-cloudflare build --config wrangler.workers.jsonc",
    "cf:preview": "opennextjs-cloudflare preview --config wrangler.workers.jsonc --port 8082",
    "cf:dry-run": "wrangler deploy --config wrangler.workers.jsonc --dry-run --outdir .open-next/dry-run",
    "pages:build": "node scripts/pages-build.mjs",
    "pages:preview": "wrangler pages dev .cf-pages --ip 127.0.0.1 --port 8083 --inspector-port 9233",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.8",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.14.12",
    "artplayer": "^5.2.3",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "hls.js": "^1.5.17",
    "mpegts.js": "^1.8.2",
    "mux.js": "^6.3.0",
    "next": "15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.27",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^26.1.0",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
