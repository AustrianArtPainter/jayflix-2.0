{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jayflix-2-0",
  "main": ".open-next/pages-entry.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
