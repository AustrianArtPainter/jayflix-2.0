{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jayflix-2-0",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "jayflix-2-0" }],
  "dev": { "ip": "127.0.0.1", "port": 8082, "local_protocol": "http" }
  // Optional local Workers target; production uses the independent Pages project.
}
